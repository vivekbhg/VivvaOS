# === Polymarket Bot Configuration ===

# Your Ethereum private key (controls your Polymarket wallet)
# NEVER commit your actual .env file!
PRIVATE_KEY=0x_your_private_key_here

# Polymarket CLOB API
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137

# Trading Parameters
MAX_POSITION_SIZE=50        # Max USD per single position
MAX_TOTAL_EXPOSURE=500      # Max USD total across all positions
MIN_EDGE=0.05               # Minimum edge (5%) to enter a trade
MIN_LIQUIDITY=1000          # Min USD liquidity in orderbook to trade
MAX_SPREAD=0.10             # Max bid-ask spread to consider

# Risk Management
STOP_LOSS=0.30              # Exit if position loses 30%
TAKE_PROFIT=0.50            # Exit if position gains 50%
MAX_MARKETS=10              # Max simultaneous market positions
COOL_DOWN_MINUTES=5         # Minutes between trade cycles

# Strategy Weights (must sum to 1.0)
STRATEGY_VALUE=0.4          # Weight for value strategy
STRATEGY_MOMENTUM=0.3       # Weight for momentum strategy
STRATEGY_MISPRICING=0.3     # Weight for mispricing/arb strategy

# Notifications (optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
DRY_RUN=true                # Set to false for live trading
